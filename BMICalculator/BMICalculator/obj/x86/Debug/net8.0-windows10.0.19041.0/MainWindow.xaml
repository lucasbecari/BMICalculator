<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BMICalculator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BMICalculator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title= "BMI Calculator"
    mc:Ignorable="d">


    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="DarkCyan" Offset="0.0"/>
                    <GradientStop Color="Navy" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <TextBlock
            Text="BMI Calculator"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            Foreground="White"
            FontWeight="ExtraBold"
            FontSize="24"
            Margin="0,10,0,10"/>
        
        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Orientation="Horizontal"
            VerticalAlignment="Center">

            <StackPanel.Resources>
                <!-- COR DO PLACEHOLDER  -->
                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="LightGray"/>

                <!-- COR DA BORDA AO PASSAR O MOUSE -->
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Black"/>

                <!-- COR DE FUNDO AO PASSAR O MOUSE  -->
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="LightGray"/>

                <!-- COR DA BORDA AO GANHAR FOCO  -->
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="DarkCyan"/>
            </StackPanel.Resources>
        <TextBlock
            Text="Height"
            Foreground="Black"
            FontWeight="ExtraBlack"
            FontSize="22"
            Margin="10"/>

        <TextBox Width="100"
                 Background="LightGray"
                 BorderBrush="DarkCyan"
                 BorderThickness="1"
                 PlaceholderText="Centimeters"
                 
                 Margin="10"/>
        </StackPanel>
        <StackPanel
        Grid.Row="2"
        Grid.Column="0"
        Orientation="Horizontal"
        VerticalAlignment="Center">

            <StackPanel.Resources>
                <!-- COR DO PLACEHOLDER  -->
                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="LightGray"/>

                <!-- COR DA BORDA AO PASSAR O MOUSE -->
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Blue"/>

                <!-- COR DE FUNDO AO PASSAR O MOUSE  -->
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="LightGray"/>

                <!-- COR DA BORDA AO GANHAR FOCO  -->
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="DarkCyan"/>
            </StackPanel.Resources>
            <TextBlock
        Text="Widght"
        Foreground="Black"
        FontWeight="ExtraBlack"
        FontSize="22"
        Margin="10"/>

            <TextBox Width="100"
             Background="LightGray"
             BorderBrush="DarkCyan"
             BorderThickness="1"
             PlaceholderText="Centimeters"
             
             Margin="3,5,2,10"/>
        </StackPanel>
        <Button Content="Calculate your BMI"
                Grid.Row="3"
                Foreground="White"
                FontSize="24"
                FontWeight="ExtraBold"
                HorizontalAlignment="Center"
                Margin="20"
                BorderBrush="Cyan"
                Command="{Binding CalculateBMI}">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <!-- Vai do DarkCyan (Esquerda) para o Navy (Direita) -->
                    <GradientStop Color="DarkCyan" Offset="0.0"/>
                    <GradientStop Color="Navy" Offset="1.0"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
                
     

    </Grid>
</Window>

